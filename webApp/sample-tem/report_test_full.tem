  "metadata": {
    "title": "TEMer レポート出力テスト (全要素網羅)",
    "author": "中田友貴 (テスト用)",
    "createdAt": "2026-05-22T13:00:00.000Z",
    "modifiedAt": "2026-05-22T13:00:00.000Z",
    "description": "論文レポート (.docx) 出力の漏れチェック用テストデータ。Box 全 8 種 (normal/OPP/BFP/EFP/P-EFP/2nd-EFP/P-2nd-EFP/annotation)、Line 全 2 種 (RLine/XLine)、SDSG の SD/SG × single/between の 4 通り、時期区分 4 期を含む。description 記入あり / noDescriptionNeeded フラグあり / 説明未記入 のパターンを意図的に混在させている。",
    "notationSystem": {
      "base": "custom",
      "customDescription": "本図は荒川・安田・サトウ (2012) を基盤としつつ、第 2 等至点 (2nd EFP) の描画を併用する独自体系を採用した。"
    },
    "participantsInfo": {
      "count": 4,
      "description": "20 代後半の大学院修了者および学部卒業就職者 計 4 名 (うち女性 2 名、男性 2 名)。",
      "hsiDescription": "HSI 水準 2: 進路選択に関わる経験者を文献および紹介を通じて段階的に招請した。",
      "pseudonyms": ["A", "B", "C", "D"]
    },
    "interview": {
      "method": "半構造化インタビュー (オンライン)",
      "durationDescription": "1 回あたり約 60〜90 分、各協力者につき計 2 回",
      "timesCount": 8,
      "analysisCombination": "TEM + 修正版 grounded theory approach (M-GTA)",
      "notes": "全 IC 文書化済み、テキスト化は逐語訳。協力者による member check を 1 回実施。"
    },
    "visualConventions": {
      "horizontalLength": {
        "hasMeaning": true,
        "description": "時間軸として用い、年月の経過を概ね等間隔で表現する。"
      },
      "arrowAngle": {
        "hasMeaning": false
      },
      "verticalPosition": {
        "hasMeaning": true,
        "description": "上下方向は職業的アイデンティティの強度を示す (上=研究志向強、下=非研究志向)。"
      },
      "colors": {
        "hasMeaning": false
      },
      "lineWeight": {
        "hasMeaning": true,
        "description": "実線=実際に経験された径路、点線=実現しなかった潜在的径路。"
      }
    },
    "reportNotes": "本テストデータは TEMer の論文レポート出力機能 (.docx) の検証専用であり、実在の研究結果ではない。Box の説明欄に複数のパターン (記入済 / 説明不要 / 未記入) を意図的に混在させているため、レポート上で『説明: ...』『（説明不要）』『（説明未記入）』が網羅的に出力されることを確認できる。"
  },
  "history": []
}
