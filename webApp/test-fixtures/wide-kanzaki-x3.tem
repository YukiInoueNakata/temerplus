          "participantId": "p_A",
          "x": 4300,
          "y": -320,
          "width": 80,
          "height": 60,
          "textOrientation": "horizontal"
        },
        {
          "id": "A_1_2_3",
          "type": "normal",
          "label": "関係がどうにもならず\n「もう無理だ」となる",
          "subLabel": "A",
          "participantId": "p_A",
          "x": 4420,
          "y": -320,
          "width": 100,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "A_1_3_3",
          "type": "normal",
          "label": "同級生に会わない形で\n別室登校",
          "subLabel": "A",
          "participantId": "p_A",
          "x": 4560,
          "y": -320,
          "width": 110,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "B_1_1_3",
          "type": "normal",
          "label": "転校することになる",
          "subLabel": "B",
          "participantId": "p_B",
          "x": 4420,
          "y": -200,
          "width": 90,
          "height": 60,
          "textOrientation": "horizontal"
        },
        {
          "id": "B_1_2_3",
          "type": "normal",
          "label": "学校に行けなくなる",
          "subLabel": "B",
          "participantId": "p_B",
          "x": 4560,
          "y": -200,
          "width": 90,
          "height": 60,
          "textOrientation": "horizontal"
        },
        {
          "id": "C_1_1_3",
          "type": "normal",
          "label": "犬猿の仲であった\n同級生とペアを組まれる",
          "subLabel": "C",
          "participantId": "p_C",
          "x": 4300,
          "y": -50,
          "width": 130,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "C_1_2_3",
          "type": "normal",
          "label": "組んで数か月で\n上位に入る",
          "subLabel": "C",
          "participantId": "p_C",
          "x": 4450,
          "y": -50,
          "width": 100,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "C_1_3_3",
          "type": "normal",
          "label": "顧問が「3年生の思い出\n作りのため引いてくれ」\nと言い出す",
          "subLabel": "C",
          "participantId": "p_C",
          "x": 4580,
          "y": -50,
          "width": 130,
          "height": 90,
          "textOrientation": "horizontal"
        },
        {
          "id": "C_1_4_3",
          "type": "normal",
          "label": "ペアの子が、親の都合で\n海外に行ってしまう",
          "subLabel": "C",
          "participantId": "p_C",
          "x": 4730,
          "y": -50,
          "width": 130,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "C_1_5_3",
          "type": "normal",
          "label": "部活を抜ける",
          "subLabel": "C",
          "participantId": "p_C",
          "x": 4880,
          "y": -50,
          "width": 80,
          "height": 60,
          "textOrientation": "horizontal"
        },
        {
          "id": "D_1_1_3",
          "type": "normal",
          "label": "学校に行くと大人しく\nなってしまう",
          "subLabel": "D",
          "participantId": "p_D",
          "x": 4300,
          "y": 150,
          "width": 110,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "D_1_2_3",
          "type": "normal",
          "label": "課題も部活動も授業での\n発表も一所懸命にやる",
          "subLabel": "D",
          "participantId": "p_D",
          "x": 4430,
          "y": 150,
          "width": 130,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "D_1_3_3",
          "type": "normal",
          "label": "本格的に休むように\nなって、学校を休み始める",
          "subLabel": "D",
          "participantId": "p_D",
          "x": 4580,
          "y": 150,
          "width": 130,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "D_1_4_3",
          "type": "normal",
          "label": "1つひとつの事が重荷に\nなり、病院に通い始める",
          "subLabel": "D",
          "participantId": "p_D",
          "x": 4730,
          "y": 150,
          "width": 130,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "D_1_5_3",
          "type": "normal",
          "label": "発達障害だと診断される",
          "subLabel": "D",
          "participantId": "p_D",
          "x": 4880,
          "y": 150,
          "width": 130,
          "height": 60,
          "textOrientation": "horizontal"
        },
        {
          "id": "BFP_A_1_3",
          "type": "BFP",
          "label": "本を借りて読む\nようになる",
          "subLabel": "A 分岐点",
          "participantId": "p_A",
          "x": 4700,
          "y": -320,
          "width": 100,
          "height": 80,
          "textOrientation": "horizontal"
        },
        {
          "id": "BFP_B_1_3",
          "type": "BFP",
          "label": "E 先生を\n尊敬するように\nなる",
          "subLabel": "B 分岐点",
          "participantId": "p_B",
          "x": 4700,
          "y": -180,
          "width": 100,
          "height": 90,
          "textOrientation": "horizontal"
        },
        {
          "id": "OPP_KOKO_3",
          "type": "OPP",
          "label": "X 高校に\n入学する",
          "x": 5050,
          "y": -80,
          "width": 100,
          "height": 130,
          "textOrientation": "horizontal"
        },
        {
          "id": "OPP_HITO_3",
          "type": "OPP",
          "label": "自然と人と関わる",
          "x": 5200,
          "y": -80,
          "width": 130,
          "height": 80,
          "textOrientation": "horizontal"
        },
        {
          "id": "A_2_1_3",
          "type": "normal",
          "label": "放課後にママになり、\nオンラインゲームを始める",
          "subLabel": "A",
          "participantId": "p_A",
          "x": 5370,
          "y": -300,
          "width": 160,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "C_2_1_3",
          "type": "normal",
          "label": "ユーモアを持って\n話せるようになる",
          "subLabel": "C",
          "participantId": "p_C",
          "x": 5370,
          "y": -100,
          "width": 130,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "B_2_1_3",
          "type": "normal",
          "label": "善意の人たちに\nもまれていく",
          "subLabel": "B",
          "participantId": "p_B",
          "x": 5370,
          "y": 80,
          "width": 120,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "D_2_1_3",
          "type": "normal",
          "label": "クラスの中に同じような\n価値観の人がいる",
          "subLabel": "D",
          "participantId": "p_D",
          "x": 5370,
          "y": 220,
          "width": 140,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "OPP_KADAI_3",
          "type": "OPP",
          "label": "学校の課題を\n頼りに自己変容\nする",
          "x": 5600,
          "y": -80,
          "width": 130,
          "height": 130,
          "textOrientation": "horizontal"
        },
        {
          "id": "A_3_1_3",
          "type": "normal",
          "label": "大学に入っても考えを\n得るため色々なことを\nやる",
          "subLabel": "A",
          "participantId": "p_A",
          "x": 5780,
          "y": -320,
          "width": 140,
          "height": 90,
          "textOrientation": "horizontal"
        },
        {
          "id": "C_3_1_3",
          "type": "normal",
          "label": "やる気のある人のなかで\n何か作り出したい",
          "subLabel": "C",
          "participantId": "p_C",
          "x": 5780,
          "y": -150,
          "width": 150,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "B_3_1_3",
          "type": "normal",
          "label": "E 先生を超えられるよう\nに頑張ろう",
          "subLabel": "B",
          "participantId": "p_B",
          "x": 5780,
          "y": 30,
          "width": 140,
          "height": 70,
          "textOrientation": "horizontal"
        },
        {
          "id": "D_3_1_3",
          "type": "normal",
          "label": "その人たちに悪意が\nだわって色々な必要が\nない",
          "subLabel": "D",
          "participantId": "p_D",
          "x": 5780,
          "y": 200,
          "width": 140,
          "height": 90,
          "textOrientation": "horizontal"
        },
        {
          "id": "EFP2_A_3",
          "type": "2nd-EFP",
          "label": "スタンスの合わない人も\n巻き込みながら色々な\nことに挑戦する",
          "subLabel": "A",
          "participantId": "p_A",
          "x": 6000,
          "y": -320,
          "width": 160,
          "height": 100,
          "textOrientation": "horizontal"
        },
        {
          "id": "EFP2_C_3",
          "type": "2nd-EFP",
          "label": "やる気のある集団の\n中で成長して自分で何かを\n作り出していきたい",
          "subLabel": "C",
          "participantId": "p_C",
          "x": 6000,
          "y": -150,
          "width": 170,
          "height": 100,
          "textOrientation": "horizontal"
        },
        {
          "id": "EFP2_B_3",
          "type": "2nd-EFP",
          "label": "善悪の判断をつけて\nはっきりとモノを言う\n人になる",
          "subLabel": "B",
          "participantId": "p_B",
          "x": 6000,
          "y": 30,
          "width": 160,
          "height": 100,
          "textOrientation": "horizontal"
        },
        {
          "id": "EFP2_D_3",
          "type": "2nd-EFP",
          "label": "ひとつに凝り固まらない\nような生き方をしたい",
          "subLabel": "D",
          "participantId": "p_D",
          "x": 6000,
          "y": 200,
          "width": 160,
          "height": 80,
          "textOrientation": "horizontal"
        }
