old_file/**/*.xlsm
old_file/**/*.pptx
old_file/**/*.pdf
old_file/2024TEA学会シンポ/

# 作業用一時ファイル（非公開）
.playwright-mcp/
*.docx

# Node / Web開発
node_modules/
webApp/node_modules/
webApp/dist/
webApp/*.tsbuildinfo
*.log

# OS / IDE
.DS_Store
.vscode/
.idea/

# CSV データ（個人情報を含む可能性）
中田_2024_TEMシンポ*.csv

# Markdown ドキュメント（非公開: 公開リポジトリには一切含めない）
*.md
**/*.md
# 公開用の最小 README のみ追跡対象に戻す
!/README.md
# LICENSE はテキストファイルなので影響なし

# docs/（調査資料・文献PDF・画像・マニュアルすべてローカル保持・非公開）
docs/*

